{
  "compilerOptions": {
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [".agents"],
  "extends": "expo/tsconfig.base"
}
