{
  "name": "alibe",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "better-auth": "^1.7.7",
    "expo": "^58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-standard-web-crypto": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lottie-react-native": "~7.5.0",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "twrnc": "^4.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-native-svg-transformer": "^1.5.3",
    "test-renderer": "^1.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "^4.6.7"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@expo/fingerprint": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "glob@^13": "^14.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest --watch=false",
    "test:watch": "jest --watchAll",
    "test:unit": "jest --ci --runInBand",
    "test:coverage": "jest --ci --runInBand --coverage",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:dev": "maestro test -e DEV_CLIENT=true .maestro/",
    "test:e2e:studio": "maestro studio",
    "build:android": "npx expo prebuild --platform android --clean && npx expo run:android --variant release",
    "build:android:dev": "npx expo prebuild --platform android --clean && npx expo run:android"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.tsx",
      "^@expo/vector-icons$": "<rootDir>/__mocks__/expoVectorIcons.tsx",
      "^@/server/auth-client$": "<rootDir>/__mocks__/auth-client.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**"
    ]
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
